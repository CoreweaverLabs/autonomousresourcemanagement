# Replace __ARM_HOSTNAME__ only in the approved server configuration.
# Caddy obtains and renews TLS after the hostname resolves to this server.
__ARM_HOSTNAME__ {
    root * /var/www/arm-page-factory/current
    encode zstd gzip
    file_server

    @html path / /index.html /robots.txt /sitemap.xml /llms.txt /schema.json
    header @html Cache-Control "public, max-age=300, stale-while-revalidate=60"

    @static path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.ico *.woff *.woff2
    header @static Cache-Control "public, max-age=31536000, immutable"

    log {
        output file /var/log/caddy/arm-page-factory-access.log
    }
}
