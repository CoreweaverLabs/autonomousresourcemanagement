[Unit]
Description=ARM Page Factory local release runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=armdeploy
Group=armdeploy
WorkingDirectory=/srv/arm-page-factory
EnvironmentFile=/etc/arm-page-factory/release.env
ExecStart=/srv/arm-page-factory/ops/vps/scripts/release.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/arm-page-factory

# This is an optional one-shot service. Do not enable a timer until its source,
# release authority, host ownership, and rollback procedure are approved.
